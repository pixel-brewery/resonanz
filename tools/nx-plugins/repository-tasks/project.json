{
  "name": "repository-tasks",
  "sourceRoot": "tools/nx-plugins/repository-tasks/src",
  "projectType": "library",
  "tags": ["type:tooling"],
  "targets": {
    "dependabot": {
      "executor": "@resonanz/repository-tasks:dependabot",
      "cache": false,
      "options": {
        "mode": "merge"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node --test --test-concurrency=1 \"tools/nx-plugins/repository-tasks/src/executors/dependabot/*.spec.mjs\"",
          "vitest run --config tools/nx-plugins/repository-tasks/vitest.config.ts"
        ],
        "parallel": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint tools/nx-plugins/repository-tasks --max-warnings 0"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tools/nx-plugins/repository-tasks/tsconfig.json --noEmit"
      }
    },
    "ci-check": {
      "executor": "nx:run-commands",
      "dependsOn": ["test"],
      "options": {
        "command": "node --test --test-concurrency=1 tools/run-forge.spec.mjs tools/build-macos-speech.spec.mjs tools/verify-public-content.spec.mjs tools/write-update-manifest.spec.mjs tools/prepare-release-assets.spec.mjs tools/verify-release-assets.spec.mjs .github/scripts/classifyCiChanges.spec.mjs forge.config.spec.mjs"
      }
    }
  }
}

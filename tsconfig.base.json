{
  "compilerOptions": {
    "rootDir": ".",
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "importHelpers": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@resonanz/assistant": ["./libs/assistant/src/index.ts"],
      "@resonanz/audio": ["./libs/audio/src/index.ts"],
      "@resonanz/contracts": ["./libs/contracts/src/index.ts"],
      "@resonanz/sessions": ["./libs/sessions/src/index.ts"]
    }
  }
}

{
  "name": "resonanz",
  "productName": "Resonanz",
  "version": "0.1.42",
  "private": true,
  "description": "Record conversations, talk with AI and revisit sessions through your local assistants.",
  "keywords": [
    "electron",
    "angular",
    "desktop-app",
    "audio-recording",
    "meeting-notes",
    "speech-to-text",
    "text-to-speech",
    "transcription",
    "voice-assistant",
    "transcript-analysis",
    "local-first",
    "codex",
    "claude-code",
    "synapse"
  ],
  "author": "Pixel Brewery",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixel-brewery/resonanz.git"
  },
  "homepage": "https://github.com/pixel-brewery/resonanz#readme",
  "bugs": {
    "url": "https://github.com/pixel-brewery/resonanz/issues"
  },
  "type": "module",
  "main": "dist/apps/desktop/main.mjs",
  "packageManager": "yarn@4.10.3",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "workspaces": [
    "apps/*",
    "libs/*",
    "tools/nx-plugins/*"
  ],
  "scripts": {
    "dev": "yarn start:unpackaged",
    "start": "yarn start:unpackaged",
    "start:unpackaged": "yarn build && electron .",
    "start:built": "electron .",
    "build": "nx run-many -t build --projects=renderer,desktop --parallel=1",
    "build:renderer": "nx build renderer",
    "build:desktop": "nx build desktop",
    "test": "vitest run --maxWorkers=1 && yarn test:tooling",
    "test:tooling": "nx run repository-tasks:ci-check",
    "test:e2e": "node tools/verify-desktop.mjs",
    "e2e": "yarn test:e2e",
    "e2e:packaged": "yarn test:e2e --packaged",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && ngc --noEmit -p apps/renderer/tsconfig.app.json && nx run repository-tasks:typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "ui:check": "node tools/check-mosaik-controls.mjs",
    "design:md": "mosaik-design-md generate",
    "design:md-check": "mosaik-design-md check",
    "agents:check": "yarn verify:skills",
    "verify:skills": "python3 .agents/scripts/sync_architect_core.py --check",
    "verify:public-content": "node tools/verify-public-content.mjs",
    "verify:audio": "node libs/audio/verify-provenance.mjs && node tools/generate-audio-worklet.mjs --check",
    "intl:analyze": "node --test tools/check-catalog-files.spec.mjs && node tools/check-catalog-files.mjs && nx run resonanz:intl:analyze",
    "intl:lint": "eslint \"libs/intl/src/assets/i18n/lang.{en,de}.json\" --max-warnings 0",
    "intl:references": "node tools/check-localization-references.mjs",
    "intl:sort": "nx run resonanz:intl:sort",
    "check:intl": "yarn intl:analyze",
    "verify:package": "node tools/verify-package.mjs",
    "verify:code": "yarn agents:check && yarn verify:public-content && yarn verify:audio && yarn format:check && yarn ui:check && yarn design:md-check && yarn intl:analyze && yarn intl:lint && yarn intl:references && yarn lint && yarn typecheck && yarn test && yarn build",
    "verify": "yarn verify:code && yarn e2e && yarn package:smoke && yarn e2e:packaged",
    "icons": "yarn icons:generate",
    "icons:generate": "node tools/generate-app-icons.mjs",
    "package": "yarn build && node tools/run-forge.mjs make",
    "package:unpacked": "yarn build && node tools/run-forge.mjs package",
    "package:smoke": "yarn package:unpacked && yarn verify:package",
    "make": "yarn package",
    "release": "yarn run release:patch",
    "release:patch": "gh workflow run release.yml --ref main -f specifier=patch",
    "release:minor": "gh workflow run release.yml --ref main -f specifier=minor",
    "release:major": "gh workflow run release.yml --ref main -f specifier=major",
    "release:dry-run": "yarn run release:nx --specifier=patch --dry-run",
    "release:nx": "nx release --skip-publish"
  },
  "dependencies": {
    "@angular/cdk": "22.2.7",
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/router": "22.2.6",
    "@floating-ui/dom": "1.8.0",
    "@lit-labs/virtualizer": "2.1.1",
    "@lit/context": "1.1.6",
    "@lit/task": "1.0.3",
    "@pixel-brewery/markdowner-core": "0.1.183",
    "@pixel-brewery/mosaik-elements": "0.1.183",
    "@pixel-brewery/mosaik-elements-angular": "0.1.183",
    "@pixel-brewery/mosaik-elements-foundation": "0.1.183",
    "@pixel-brewery/mosaik-icons": "0.1.183",
    "@pixel-brewery/mosaik-themes": "0.1.183",
    "@pixel-brewery/synapse-auth": "0.0.3",
    "@pixel-brewery/synapse-core": "0.0.3",
    "@pixel-brewery/synapse-provider-claude": "0.0.3",
    "@pixel-brewery/synapse-provider-codex": "0.0.3",
    "@pixel-brewery/synapse-provider-opencode": "0.0.3",
    "@pixel-brewery/synapse-runtime": "0.0.3",
    "@resonanz/assistant": "workspace:*",
    "@resonanz/audio": "workspace:*",
    "@resonanz/contracts": "workspace:*",
    "@resonanz/intl": "workspace:*",
    "@resonanz/sessions": "workspace:*",
    "chroma-js": "3.3.0",
    "electron-native-speech": "0.1.6",
    "electron-native-speech-backend-macos": "0.1.7",
    "lit": "3.3.3",
    "marked": "18.2.1",
    "qr-creator": "1.0.0",
    "rxjs": "7.8.2",
    "signature_pad": "5.1.6",
    "tslib": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.2.7",
    "@angular-devkit/schematics": "22.2.7",
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/core": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron/asar": "4.3.2",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@google/design.md": "0.4.0",
    "@nx/angular": "24.0.6",
    "@nx/devkit": "24.0.6",
    "@nx/js": "24.0.6",
    "@nx/workspace": "24.0.6",
    "@pixel-brewery/mosaik-mcp": "0.1.213",
    "@pixel-brewery/wortlaut-eslint-rules": "0.2.7",
    "@pixel-brewery/wortlaut-nx-tasks": "0.2.7",
    "@resonanz/repository-tasks": "workspace:*",
    "@schematics/angular": "22.2.7",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "electron": "45.4.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.1",
    "jsonc-parser": "3.3.1",
    "nx": "24.0.6",
    "playwright": "1.65.1",
    "prettier": "3.9.10",
    "sass": "1.108.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.5",
    "vitest": "5.1.1"
  },
  "nx": {
    "includedScripts": [],
    "projectType": "application",
    "tags": [
      "scope:desktop",
      "type:application"
    ]
  }
}

{
  "name": "resonanz",
  "productName": "Resonanz",
  "version": "0.1.2",
  "private": true,
  "description": "Record conversations, talk with AI and revisit sessions through your local assistants.",
  "author": "Pixel Brewery",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixel-brewery/resonanz.git"
  },
  "homepage": "https://github.com/pixel-brewery/resonanz#readme",
  "bugs": {
    "url": "https://github.com/pixel-brewery/resonanz/issues"
  },
  "type": "module",
  "main": "dist/apps/desktop/main.mjs",
  "packageManager": "yarn@4.10.3",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "start": "yarn build && electron .",
    "start:built": "electron .",
    "build": "nx run-many -t build --projects=renderer,desktop --parallel=1",
    "build:renderer": "nx build renderer",
    "build:desktop": "nx build desktop",
    "test": "vitest run --maxWorkers=1 && yarn test:tooling",
    "test:tooling": "node --test --test-concurrency=1 tools/run-forge.spec.mjs tools/verify-public-content.spec.mjs tools/write-update-manifest.spec.mjs tools/prepare-release-assets.spec.mjs tools/verify-release-assets.spec.mjs .github/scripts/mergeDependabotPullRequest.spec.mjs .github/scripts/requestMergedRelease.spec.mjs .github/scripts/rebaseDependabotPullRequests.spec.mjs forge.config.spec.mjs",
    "test:e2e": "node tools/verify-desktop.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && ngc --noEmit -p apps/renderer/tsconfig.app.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:skills": "python3 .agents/scripts/sync_architect_core.py --check",
    "verify:vendor": "node tools/verify-vendor.mjs",
    "verify:public-content": "node tools/verify-public-content.mjs",
    "verify:audio": "node libs/audio/verify-provenance.mjs && node tools/generate-audio-worklet.mjs --check",
    "verify:package": "node tools/verify-package.mjs",
    "verify": "yarn verify:skills && yarn verify:public-content && yarn verify:vendor && yarn verify:audio && yarn typecheck && yarn test && yarn build",
    "icons": "node tools/generate-app-icons.mjs",
    "package": "yarn build && node tools/run-forge.mjs package",
    "make": "yarn build && node tools/run-forge.mjs make",
    "release": "yarn run release:patch",
    "release:patch": "gh workflow run release.yml --ref main -f specifier=patch",
    "release:minor": "gh workflow run release.yml --ref main -f specifier=minor",
    "release:major": "gh workflow run release.yml --ref main -f specifier=major",
    "release:dry-run": "yarn run release:nx --specifier=patch --dry-run",
    "release:nx": "nx release --skip-publish"
  },
  "dependencies": {
    "@angular/cdk": "22.2.5",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",

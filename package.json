    "@pixel-brewery/synapse-provider-opencode": "file:./vendor/synapse/synapse-provider-opencode-0.0.3.tgz",
    "@pixel-brewery/synapse-runtime": "file:./vendor/synapse/synapse-runtime-0.0.3.tgz",
    "@resonanz/assistant": "workspace:*",
    "@resonanz/audio": "workspace:*",
    "@resonanz/contracts": "workspace:*",
    "@resonanz/intl": "workspace:*",

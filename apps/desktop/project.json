{
  "name": "desktop",
  "projectType": "application",
  "sourceRoot": "apps/desktop/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["production", "^production", "{workspaceRoot}/tools/build-node-apps.mjs"],
      "options": { "command": "node tools/build-node-apps.mjs" },
      "outputs": ["{workspaceRoot}/dist/apps/desktop", "{workspaceRoot}/dist/apps/orchestrator"]
    }
  }
}
